  "stages": {
    "0": {
      "number": 0,
      "key": "setup",
      "title": "Tahap 0 — Parameter Publik",
      "blocks": [
        {
          "label": "0. Pembangkitan safe prime dan generator",
          "formula": "p = 2q + 1, dengan p dan q prima; g ∈ [2, p-2]",
          "substitution": "p = 46199 (safe prime, 16 bit)\nq = 23099 (prima, 15 bit)\nverifikasi: 2·q + 1 = 46199 = p\ng = 27008; periksa g² mod p = 42252 ≠ 1 dan g^q mod p = 46198 ≠ 1",
          "result": "Parameter publik siap dibagikan melalui jaringan.",
          "tone": "success"
        }
      ],
      "summary": "p = 46199 · q = 23099 · g = 27008",
      "note": "Mode Mode Demo (16 bit). Aman prima berarti p = 2q + 1 sehingga grup perkalian modulo p memiliki subgrup besar berorder prima q. Waktu pembangkitan: 0.2 ms.",
      "values": {
        "p": "46199",
        "q": "23099",
        "g": "27008",
        "bits": 16
      }
    },
    "1": {
      "number": 1,
      "key": "keygen",
      "title": "Tahap 1 — Pembangkitan Kunci ElGamal Server",
      "blocks": [
        {
          "label": "1a. Pilih kunci privat x",
          "formula": "x ∈ [2, p-2], x rahasia",
          "substitution": "x = 37205",
          "result": "x hanya disimpan di panel server."
        },
        {
          "label": "1b. Hitung kunci publik y",
          "formula": "y = g^x mod p",
          "substitution": "y = 27008^37205 mod 46199 = 35786",
          "result": "Kunci publik server: y = 35786",
          "tone": "success"
        }
      ],
      "summary": "y = 35786",
      "note": "y boleh diketahui semua pihak, termasuk Eve. x tetap rahasia server.",
      "values": {
        "x": "37205",
        "y": "35786"
      }
    },
    "2": {
      "number": 2,
      "key": "dh",
      "title": "Tahap 2 — Diffie-Hellman",
      "blocks": [
        {
          "label": "2a. Pemain memilih a dan mengirim A",
          "formula": "a ∈ [2, p-2] (rahasia) ; A = g^a mod p",
          "substitution": "a = 18537\nA = 27008^18537 mod 46199 = 19982",
          "result": "Pemain → Server: A = 19982"
        }
      ],
      "summary": "Menunggu pertukaran kunci.",
      "note": "K tidak pernah dikirim. Eve hanya melihat A dan B. Untuk mendapat K, Eve harus menyelesaikan logaritma diskret a atau b.",
      "values": {
        "a": "18537",
        "A": "19982",
        "b": null,
        "B": null,
        "K_player": null,
        "K_server": null,
        "verified": false
      }
    },
    "3": {
      "number": 2,
      "key": "dh",
      "title": "Tahap 2 — Diffie-Hellman",
      "blocks": [
        {
          "label": "2a. Pemain memilih a dan mengirim A",
          "formula": "a ∈ [2, p-2] (rahasia) ; A = g^a mod p",
          "substitution": "a = 18537\nA = 27008^18537 mod 46199 = 19982",
          "result": "Pemain → Server: A = 19982"
        },
        {
          "label": "2b. Server memilih b dan mengirim B",
          "formula": "b ∈ [2, p-2] (rahasia) ; B = g^b mod p",
          "substitution": "b = 6461\nB = 27008^6461 mod 46199 = 29174",
          "result": "Server → Pemain: B = 29174"
        },
        {
          "label": "2c. Kedua pihak menghitung K",
          "formula": "K_pemain = B^a mod p ; K_server = A^b mod p",
          "substitution": "K_pemain = 29174^18537 mod 46199 = 36691\nK_server = 19982^6461 mod 46199 = 36691",
          "result": "K_pemain = 36691\nK_server = 36691",
          "tone": "success"
        },
        {
          "label": "2d. Pemeriksaan otomatis",
          "formula": "K_pemain == K_server ?",
          "substitution": "36691 == 36691",
          "result": "SAMA — kunci sesi berhasil disepakati (indikator hijau).",
          "tone": "success"
        }
      ],
      "summary": "K = 36691 (terverifikasi sama di kedua sisi)",
      "note": "K tidak pernah dikirim. Eve hanya melihat A dan B. Untuk mendapat K, Eve harus menyelesaikan logaritma diskret a atau b.",
      "values": {
        "a": "18537",
        "A": "19982",
        "b": "6461",
        "B": "29174",
        "K_player": "36691",
        "K_server": "36691",
        "verified": true
      }
    },
    "4": {
      "number": 3,
      "key": "mask",
      "title": "Tahap 3 — Penyamaran Pesan dengan Kunci Sesi",
      "blocks": [
        {
          "label": "3a. Pesan asli pemain",
          "formula": "0 ≤ m < p",
          "substitution": "m = 1 → Aksi: Serang",
          "result": "Pesan asli: Aksi: Serang"
        },
        {
          "label": "3b. Samarkan dengan K hasil Diffie-Hellman",
          "formula": "m' = (m + K) mod p",
          "substitution": "m' = (1 + 36691) mod 46199 = 36692",
          "result": "Pesan bertopeng: m' = 36692",
          "tone": "success"
        }
      ],
      "summary": "m = 1 → m' = 36692",
      "note": "m' inilah yang akan dienkripsi ElGamal. Tanpa K, Eve tidak dapat memulihkan m walau ia berhasil memecahkan ElGamal.",
      "values": {
        "m": "1",
        "m_prime": "36692",
        "K": "36691",
        "data_type": "action",
        "label": "Aksi: Serang"
      }
    },
    "5": {
      "number": 4,
      "key": "encrypt",
      "title": "Tahap 4 — Enkripsi ElGamal oleh Pemain",
      "blocks": [
        {
          "label": "4a. Pilih nonce k",
          "formula": "2 ≤ k ≤ p-2 ; FPB(k, p-1) = 1",
          "substitution": "k = 2817\nFPB(2817, 46198) = 1",
          "result": "Nonce sesi: k = 2817 (rahasia pemain, dipakai sekali)."
        },
        {
          "label": "4b. Hitung c1",
          "formula": "c1 = g^k mod p",
          "substitution": "c1 = 27008^2817 mod 46199 = 41284",
          "result": "c1 = 41284"
        },
        {
          "label": "4c. Hitung c2",
          "formula": "c2 = m' · y^k mod p",
          "substitution": "y^k mod p = 35786^2817 mod 46199 = 44879\nc2 = (36692 · 44879) mod 46199 = 29311",
          "result": "c2 = 29311",
          "tone": "success"
        }
      ],
      "summary": "(c1, c2) = (41284, 29311)",
      "note": "Kedua bilangan ini yang melintasi jaringan dan dapat disadap Eve.",
      "values": {
        "k": "2817",
        "c1": "41284",
        "c2": "29311",
        "yk": "44879"
      }
    },
    "6": {
      "number": 5,
      "key": "decrypt",
      "title": "Tahap 5 — Dekripsi ElGamal oleh Server",
      "blocks": [
        {
          "label": "5a. Dekripsi ElGamal",
          "formula": "s = c1^x mod p ; m' = c2 · s^-1 mod p",
          "substitution": "s = 41284^37205 mod 46199 = 44879\ns^-1 mod p = 46164  (cek s·s^-1 mod p = 1)\nm' = 29311 · 46164 mod 46199 = 36692",
          "result": "Pesan bertopeng diterima: m' = 36692"
        },
        {
          "label": "5b. Lepas topeng dengan K",
          "formula": "m = (m' - K) mod p",
          "substitution": "m = (36692 - 36691) mod 46199 = 1",
          "result": "Data diterima server: Aksi: Serang",
          "tone": "success"
        }
      ],
      "summary": "Aksi: Serang",
      "note": "Server memakai x untuk membuka ElGamal, lalu K hasil DH untuk melepas topeng. Kedua rahasia harus benar agar m pulih.",
      "values": {
        "s": "44879",
        "s_inv": "46164",
        "m_prime": "36692",
        "m": "1",
        "label": "Aksi: Serang",
        "valid": true
      }
